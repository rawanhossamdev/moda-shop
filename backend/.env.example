# Copy to .env and replace the placeholders for your own local database.
# Never commit .env. URL-encode special characters in credentials.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
DATABASE_URL=postgresql://moda_user:replace_me@localhost:5432/moda_shop?schema=public

# Run npm run auth:secret to generate a random secret in your private .env.
JWT_SECRET=
# Access-token lifetime: 300 through 604800 seconds (7 days).
JWT_TTL_SECONDS=604800

# Shared Resend delivery for signup verification, resend and password recovery.
# API key stays on the backend. All values here are placeholders, never secrets.
RESEND_API_KEY=
# Optional HIBP k-anonymity screening on registration and reset (no full
# password/hash is sent). When enabled, provider failure returns 503.
CHECK_BREACHED_PASSWORDS=false

# Keep false until the owner separately authorizes real email delivery.
# New local accounts can register/login, but verified checkout requires a
# verified disposable account; tests simulate verified state without mail.
EMAIL_DELIVERY_ENABLED=false
# development restricts ALL mail to EMAIL_TEST_RECIPIENT, never redirects it.
EMAIL_MODE=development
# Development example: MODA Shop <onboarding@resend.dev>
EMAIL_FROM=
# Set this to the exact email address authorized by YOUR Resend account.
EMAIL_TEST_RECIPIENT=
# Set true only after verifying your own sender domain in Resend.
# Production requires EMAIL_MODE=production and a verified custom EMAIL_FROM.
EMAIL_DOMAIN_VERIFIED=false

# No conversion is performed. Current catalog/database pricing is USD only.
STORE_CURRENCY=USD
# Integer minor units of STORE_CURRENCY; 0 means free shipping.
SHIPPING_FEE_CENTS=0

# Sandbox-only. All credentials/currency/URLs are required before methods appear.
PAYMOB_ENABLED=false
PAYMOB_MODE=test
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_OWNER_ID=
PAYMOB_CURRENCY=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_NOTIFICATION_URL=
PAYMOB_RETURN_URL=

